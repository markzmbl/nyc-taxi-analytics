# ── Build stage ───────────────────────────────────────────────────────────────
FROM python:3.13.5-slim-bookworm AS builder

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps first for layer caching
COPY pyproject.toml .
RUN pip install --no-cache-dir . && \
    pip install --no-cache-dir dbt-core dbt-postgres

# Copy app code (owned by root during build; fixed in runtime stage)
COPY . .

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM python:3.13.5-slim-bookworm

# Create non-root user
RUN groupadd -r dagster && useradd -r -g dagster -m -s /bin/bash dagster

RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq-dev curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy app code and fix ownership
COPY --from=builder --chown=dagster:dagster /app /app

# Pre-install dbt dependencies.
# OPTION 1 — Build-time (current): packages are baked into the image.
#   Pro: no volume mount needed in production, image is self-contained.
#   Con: packages are re-downloaded on every build; image size increases.
#
# OPTION 2 — Volume mount (development): comment out the line below and
#   mount ./dbt/packages into the container at /app/dbt/packages. This
#   keeps packages across rebuilds and speeds up local iteration.
#   In docker-compose.yml, add:
#     volumes:
#       - ./dbt/packages:/app/dbt/packages
RUN cd /app/dbt && dbt deps --profiles-dir . 2>/dev/null || true

USER dagster

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Default: webserver.  Override CMD for daemon:
#   CMD ["dagster-daemon", "run"]
CMD ["dagster-webserver", "-h", "0.0.0.0", "-p", "3000", "-w", "workspace.yaml"]
