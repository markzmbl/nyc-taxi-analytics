# OpenHands → z.ai (LiteLLM). Copy to .env and fill in the key.
# Rotate the z.ai key you pasted earlier — treat it as compromised.
LLM_MODEL=openai/glm-4.6                       # verify current z.ai model name
LLM_BASE_URL=https://api.z.ai/api/paas/v4      # z.ai OpenAI-compatible endpoint (verify)
LLM_API_KEY=                                   # your z.ai API key
