# ============================================================================
# NYC Taxi Analytics — local dev environment
# Copy to .env:  cp .env.example .env
# Dagster runs natively with `dagster dev`, Postgres + Metabase in Docker
# ============================================================================

# ---------- Postgres (Docker, exposed on localhost:5432) ----------
PG_HOST=localhost
PG_USER=dagster
PG_PASSWORD=dagster

# ---------- Airbyte OSS (runs via `abctl local install`) ----------
# API available at localhost:8006 after abctl starts
AIRBYTE_REST_API_BASE_URL=http://localhost:8006/api/public/v1
AIRBYTE_CONFIGURATION_API_BASE_URL=http://localhost:8006/api/v1
AIRBYTE_WORKSPACE_ID=
AIRBYTE_USERNAME=airbyte@example.com
AIRBYTE_PASSWORD=password

# ---------- Dagster internals ----------
DAGSTER_HOME=./dagster_home
DAGSTER_POSTGRES_HOST=localhost
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster
DAGSTER_POSTGRES_DB=dagster

# ---------- External APIs ----------
# EPA Air Quality System — free key at https://aqs.epa.gov/aqsweb/documents/data_api.html
EPA_API_KEY=
EPA_EMAIL=test@example.com

# ---------- MinIO (S3-compatible storage for Airbyte OSS) ----------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
