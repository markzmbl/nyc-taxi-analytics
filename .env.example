# ============================================================================
# Analytics blueprint — local dev environment.  Copy to .env:  cp .env.example .env
# ============================================================================

# ---------- Stack selection (tier × warehouse × ingestion × serving) ----------
# One switch drives dlt + dbt + config. Studio defaults shown.
STACK_TIER=studio                 # studio | atelier | resident
STACK_WAREHOUSE=duckdb            # duckdb | motherduck | clickhouse
STACK_INGESTION=dlt               # dlt | airbyte
STACK_SERVING=["metabase"]        # JSON list: metabase | superset | cube

# ---------- Warehouse engines (set the one selected by STACK_WAREHOUSE) -------
# DuckDB (Studio): local file
DUCKDB_PATH=warehouse.duckdb
# MotherDuck (managed DuckDB): token required when selected
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=warehouse
# ClickHouse (Atelier/Resident): host required when selected
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=warehouse
CLICKHOUSE_SECURE=false

# ---------- Postgres — legacy/operational only (NOT a warehouse engine) -------
# Used by the optional Airbyte plugin and the legacy NYC pipeline.
PG_HOST=localhost
PG_USER=dagster
PG_PASSWORD=dagster
PG_PORT=5432
PG_DB=warehouse

# ---------- Airbyte OSS (runs via `abctl local install`) ----------
# API available at localhost:8006 after abctl starts
AIRBYTE_REST_API_BASE_URL=http://localhost:8006/api/public/v1
AIRBYTE_CONFIGURATION_API_BASE_URL=http://localhost:8006/api/v1
AIRBYTE_WORKSPACE_ID=
AIRBYTE_USERNAME=airbyte@example.com
AIRBYTE_PASSWORD=password
# Host the Airbyte process uses to reach the warehouse Postgres.
# Docker Desktop: host.docker.internal | Linux/K8s: service DNS or node IP.
AIRBYTE_DEST_POSTGRES_HOST=host.docker.internal

# ---------- Dagster internals ----------
DAGSTER_HOME=./dagster_home
DAGSTER_POSTGRES_HOST=localhost
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster
DAGSTER_POSTGRES_DB=dagster

# ---------- External APIs ----------
# EPA Air Quality System — free key at https://aqs.epa.gov/aqsweb/documents/data_api.html
EPA_API_KEY=
EPA_EMAIL=test@example.com

# ---------- MinIO (S3-compatible storage for Airbyte OSS) ----------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
