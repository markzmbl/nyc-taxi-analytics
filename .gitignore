# Secrets — never commit real credentials
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node (e.g. Cube serving)
node_modules/

# Dagster local state
dagster_home/storage/
dagster_home/.telemetry/
dagster_home/*.yaml.lock

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
transform/target/
transform/dbt_packages/
transform/logs/

# Local warehouse files & dlt state (Studio tier)
*.duckdb
*.duckdb.wal
.dlt/

# IDE / local agent settings
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db

# Terraform — state files contain secrets, never commit
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
.terraform/
crash.log
crash.*.log

# Docker
*.log

# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
